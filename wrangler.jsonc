{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site: `npm run build` exports to ./out, which Cloudflare serves as Worker static assets.
  "name": "bitfest-2027",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "kuetbitfest2027.com", "custom_domain": true },
    { "pattern": "www.kuetbitfest2027.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
