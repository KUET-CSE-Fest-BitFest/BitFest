# Apache rules for the cPanel copy of the site (csefest.kuet.ac.bd). The Cloudflare copy ignores
# this file (see .assetsignore) and uses _headers instead; keep the two in step.

Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/plain .txt

# Build-only files that should never be served.
<FilesMatch "^(\.htaccess|_headers|\.assetsignore|\.cpanel\.yml)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /events/iupc/ -> /events/iupc (one address per page)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /events/iupc -> events/iupc.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # A folder with no page of its own (/events, /_next) is a 404, not a listing or a 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Hashed build files never change; images change rarely; pages are always rechecked.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/past/#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#^/og/#">
    Header set Cache-Control "public, max-age=86400"
  </ElseIf>
  <Else>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
