# Server rules for csefest.kuet.ac.bd (BdREN cPanel, LiteSpeed or Apache). Longer cache times for
# images and build files sit in .htaccess files in those folders (public/past, public/og, and
# _next/static, which .github/workflows/cpanel-build.yml writes after the build).

# Kept from the server's own .htaccess so a deploy does not drop cPanel's PHP settings.
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/csefestkuet/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/csefestkuet/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

<IfModule mod_negotiation.c>
  Options -MultiViews -Indexes
</IfModule>
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/plain .txt

# Build-only files that should never be served.
<FilesMatch "^(\.htaccess|\.cpanel\.yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /events/iupc/ -> /events/iupc (one address per page)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /events/iupc -> events/iupc.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # A folder with no page of its own (/events, /_next) is a 404, not a listing or a 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Pages are rechecked on every visit so a deploy shows at once.
  Header set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
